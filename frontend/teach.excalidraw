    {
      "id": "wJP1vvCzqaONm5uNPLMVz",
      "type": "text",
      "x": -1093.851464759514,
      "y": -149.45872113124744,
      "width": 1634.978759765625,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b08",
      "roundness": null,
      "seed": 1665588174,
      "version": 3,
      "versionNonce": 278970446,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768893587920,
      "link": null,
      "locked": false,
      "text": "// Context API is a built-in feature in React that allows components to share data globally without passing props manually through every level of the component tree.\n\n// It solves the problem of prop drilling.\n\n// In React:\n    // Data flows from parent to child using props\n    // When data is needed deep in the tree, props must be passed through many components\n\n// This leads to:\n    // Unnecessary props\n    // Tight coupling between components\n    // Difficult maintenance\n    // Context API provides a common data source accessible by all components.(like global state)\n\n// Steps to use Context API:\n    // 1. Create a Context\n    // 2. Create a Provider component\n    // 3. Wrap the component tree with the Provider(root compnent ko wrap krna hota h)\n    // 4. Consume the context data in child components using useContext hook\n\n\n// createContext() - Creates a Context object\n// Provider - Component that provides the context value to its children\n// useContext() - Hook to consume the context value in functional components",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Context API is a built-in feature in React that allows components to share data globally without passing props manually through every level of the component tree.\n\n// It solves the problem of prop drilling.\n\n// In React:\n    // Data flows from parent to child using props\n    // When data is needed deep in the tree, props must be passed through many components\n\n// This leads to:\n    // Unnecessary props\n    // Tight coupling between components\n    // Difficult maintenance\n    // Context API provides a common data source accessible by all components.(like global state)\n\n// Steps to use Context API:\n    // 1. Create a Context\n    // 2. Create a Provider component\n    // 3. Wrap the component tree with the Provider(root compnent ko wrap krna hota h)\n    // 4. Consume the context data in child components using useContext hook\n\n\n// createContext() - Creates a Context object\n// Provider - Component that provides the context value to its children\n// useContext() - Hook to consume the context value in functional components",
      "autoResize": true,
      "lineHeight": 1.25
    },
